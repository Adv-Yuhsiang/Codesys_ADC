<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ADCManagedTestTypes</AssemblyName>
    <RootNamespace>ADCManagedTestTypes</RootNamespace>
  </PropertyGroup>

  <Target Name="CopyTestAssembly" AfterTargets="Build">
    <MakeDir Directories="..\library\x86;..\library\x64" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="..\library\x86" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="..\library\x64" SkipUnchangedFiles="true" />
  </Target>

</Project>
